# Salin file ini menjadi .env lalu sesuaikan nilainya

# Koneksi PostgreSQL (format Prisma). Untuk docker-compose default di bawah ini sudah cocok.
DATABASE_URL="postgresql://servopay:servopay@localhost:5432/servopay?schema=public"

# Port server Express
PORT=4000

# Secret untuk menandatangani JWT — WAJIB diganti nilai acak yang panjang saat production
JWT_SECRET="ganti-dengan-string-acak-yang-panjang-dan-rahasia"
JWT_EXPIRES_IN="7d"

# Origin frontend yang diizinkan mengakses API ini (CORS). Pisahkan dengan koma jika lebih dari satu.
# Di production WAJIB diisi domain spesifik, jangan pakai "*".
# Dev monorepo: web-app :5173, landing-page :5174, platform-admin :5175.
# Contoh: CORS_ORIGIN="https://app.ordria.id,https://ordria.id,https://admin.ordria.id"
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost:5175"

# Midtrans Payment Gateway (global — dipakai jika Business.midtransMode = global)
# Dapatkan dari https://dashboard.midtrans.com -> Settings -> Access Keys (Sandbox/Production)
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
# Opsional, umumnya tidak perlu diisi — Midtrans default gopay untuk QRIS.
# Kosongkan agar field qris.acquirer tidak dikirim sama sekali.
MIDTRANS_QRIS_ACQUIRER=""
# Secret untuk enkripsi ServerKey per-business saat midtransMode = custom
MIDTRANS_KEY_ENCRYPTION_SECRET="ganti-dengan-32-char-random-secret-untuk-enkripsi"
# URL publik backend untuk menerima webhook Midtrans (X-Override-Notification)
# Untuk lokal, gunakan ngrok atau sejenis: https://<xxx>.ngrok.io/api/public/midtrans/notification
MIDTRANS_NOTIFICATION_URL=""

# Redis opsional untuk fan-out realtime SSE lintas instance (mis. Upstash).
# Tanpa ini backend jalan mode in-process (cukup untuk 1 instance / dev / Hostinger).
# Contoh: REDIS_URL="rediss://default:<password>@<host>.upstash.io:6379"
REDIS_URL=""

# Email transaksional (link reset password owner). Tanpa ini, link hanya
# dicetak ke console server (mode dev) agar alur tetap bisa diuji.
# Contoh Gmail: SMTP_HOST="smtp.gmail.com", SMTP_PORT="587", SMTP_USER="akun@gmail.com",
# SMTP_PASS="<app password>", SMTP_FROM="Ordria <akun@gmail.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Basis URL web-app untuk link reset password (tanpa trailing slash).
# Contoh prod: FRONTEND_URL="https://app.ordria.id"
FRONTEND_URL="http://localhost:5173"
