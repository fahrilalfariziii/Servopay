# Salin file ini menjadi .env lalu sesuaikan nilainya

# Koneksi PostgreSQL (format Prisma). Untuk docker-compose default di bawah ini sudah cocok.
DATABASE_URL="postgresql://servopay:servopay@localhost:5432/servopay?schema=public"

# Port server Express
PORT=4000

# Secret untuk menandatangani JWT — WAJIB diganti nilai acak yang panjang saat production
JWT_SECRET="ganti-dengan-string-acak-yang-panjang-dan-rahasia"
JWT_EXPIRES_IN="12h"

# Origin frontend yang diizinkan mengakses API ini (CORS). Pisahkan dengan koma jika lebih dari satu.
CORS_ORIGIN="http://localhost:5173"
