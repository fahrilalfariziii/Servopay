# Base URL publik untuk QR meja self-order (dibuka HP pelanggan setelah scan).
# Contoh dev: http://localhost:5173
# Contoh prod: https://yourdomain.com
# Kosongkan = pakai window.location.origin saat ini.
VITE_PUBLIC_BASE_URL=http://localhost:5173

# Base path backend bila FE sudah tersambung API (tahap integrasi berikutnya).
VITE_API_BASE_URL=http://localhost:4000
